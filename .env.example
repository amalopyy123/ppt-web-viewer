# Administrator login password. Replace this value before starting the website.
ADMIN_PASSWORD=replace-with-a-strong-password

# Use a long random value for Flask session signing.
SECRET_KEY=replace-with-a-long-random-string

# Use 127.0.0.1 when Nginx runs on the same server.
HOST=127.0.0.1
PORT=5000

# Public HTTPS origin used by PDF.js to load the PDF on mobile devices.
# Leave empty only when the site is accessed through a directly reachable host.
PUBLIC_BASE_URL=https://example.com

# Required only when binding directly to every network interface.
ALLOW_PUBLIC_BIND=false

# Comma-separated IP addresses or CIDR networks allowed to access /admin.
ADMIN_IP_WHITELIST=127.0.0.1,::1

# Enable this behind Nginx so the whitelist uses the visitor's real IP.
TRUST_PROXY=false

# Enable only for local development.
FLASK_DEBUG=false
